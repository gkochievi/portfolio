# https://editorconfig.org — keeps every editor agreeing with the repo's
# formatting, including the config files no formatter touches.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{conf,nginx}]
indent_size = 4

[{_redirects,*.txt}]
# Column-aligned by hand; leave it alone.
max_line_length = off

[*.{png,jpg,jpeg,gif,webp,avif,ico,woff,woff2,ttf,otf}]
insert_final_newline = false
