{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Business portfolio site and the live product demos it links to",
  "workspaces": [
    "packages/*",
    "site",
    "demos/*"
  ],
  "scripts": {
    "dev:site": "npm --workspace site run dev",
    "dev:printomato": "npm --workspace @demos/printomato run dev",
    "dev:tonnaro": "npm --workspace @demos/tonnaro run dev",
    "dev:nabadi": "npm --workspace @demos/nabadi run dev",
    "dev:gisheri": "npm --workspace @demos/gisheri run dev",
    "dev:tova": "npm --workspace @demos/tova run dev",
    "dev:bani": "npm --workspace @demos/bani run dev",
    "dev:rigi": "npm --workspace @demos/rigi run dev",
    "dev:sinji": "npm --workspace @demos/sinji run dev",
    "dev:dareke": "npm --workspace @demos/dareke run dev",
    "dev:chiti": "npm --workspace @demos/chiti run dev",
    "dev:azri": "npm --workspace @demos/azri run dev",
    "build": "node scripts/build-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "node scripts/preview.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
